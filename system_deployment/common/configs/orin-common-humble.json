{
  "schema_version": 1,
  "id": "orin-common-humble",
  "package_name": "navi-common-dep",
  "release_version": "2.0.0~humble+9",
  "device_config_target": "orin-humble",
  "description": "Native Orin Humble offline common dependency bootstrap",
  "target": {
    "os_id": "ubuntu",
    "os_version": "22.04",
    "architecture": "arm64",
    "machine": "aarch64",
    "required_files": ["/etc/nv_tegra_release"],
    "require_non_root": true
  },
  "manifest": "projects/system_deployment/common/manifests/orin-humble/apt-packages.tsv",
  "output_dir": "dist/common/orin/base",
  "artifact_filename": "navi_common_dep-2.0.0-release-humble-arm64.deb",
  "deb_depends": ["bash (>= 5.1)", "coreutils (>= 8.32)", "dpkg (>= 1.21.1ubuntu2)", "apt (>= 2.4.5)"],
  "parent_packages": [],
  "installer_aliases": ["install_common_deps.sh"],
  "exact_packages": [],
  "vendor_debs": [],
  "extra_files": [
    {
      "source": "projects/system_deployment/common/files/etc/profile.d/zj_humanoid.sh",
      "destination": "etc/profile.d/zj_humanoid.sh",
      "mode": "0644"
    },
    {
      "source": "projects/system_deployment/common/templates/device.env.example",
      "destination": "etc/zj_humanoid/device.env",
      "mode": "0644",
      "conffile": true
    },
    {
      "source": "projects/system_deployment/common/files/etc/zj_humanoid/cyclonedds.xml",
      "destination": "etc/zj_humanoid/cyclonedds.xml",
      "mode": "0644",
      "conffile": true
    },
    {
      "source": "projects/system_deployment/common/deploy_common.py",
      "destination": "usr/lib/navi-common-dep/deploy_common.py",
      "mode": "0755"
    },
    {
      "source": "projects/system_deployment/common/configs/targets.json",
      "destination": "usr/lib/navi-common-dep/configs/targets.json",
      "mode": "0644"
    },
    {
      "source": "projects/system_deployment/common/configs/robot-types.json",
      "destination": "usr/lib/navi-common-dep/configs/robot-types.json",
      "mode": "0644"
    },
    {
      "source": "projects/system_deployment/COMMON_DEB_USAGE.md",
      "destination": "usr/share/doc/navi-common-dep/USAGE.md",
      "mode": "0644"
    }
  ],
  "publish": {
    "directory": "/ros2_modules/common/orin/develop/",
    "remote_name": "navi_common_dep-2.0.0-release-humble-arm64.deb"
  }
}
