{
  "schema_version": 1,
  "id": "pico-jazzy-common",
  "package_name": "navi-pico-common-dep",
  "release_version": "2.0.0~jazzy+1",
  "device_config_target": "pico-jazzy",
  "description": "Pico Ubuntu 24.04 ROS 2 Jazzy environment bootstrap",
  "environment_only": true,
  "target": {
    "os_id": "ubuntu",
    "os_version": "24.04",
    "architecture": "amd64",
    "machine": "x86_64",
    "required_files": [],
    "require_non_root": true
  },
  "manifest": "common/manifests/pico-jazzy/apt-packages.tsv",
  "output_dir": "../dist/common/pico/base-jazzy",
  "artifact_filename": "navi_pico_common_dep-2.0.0-release-jazzy-amd64.deb",
  "deb_depends": ["bash (>= 5.0)", "python3 (>= 3.12)"],
  "parent_packages": [],
  "installer_aliases": ["configure_pico_jazzy_environment.sh"],
  "exact_packages": [],
  "vendor_debs": [],
  "extra_files": [
    {
      "source": "common/files/etc/profile.d/zj_humanoid.sh",
      "destination": "etc/profile.d/zj_humanoid.sh",
      "mode": "0644"
    },
    {
      "source": "common/templates/Middleware.pico.env",
      "destination": "etc/nav01/Middleware.env",
      "mode": "0644",
      "conffile": true
    },
    {
      "source": "common/templates/device.env.example",
      "destination": "etc/zj_humanoid/device.env",
      "mode": "0644",
      "conffile": true
    },
    {
      "source": "common/files/etc/zj_humanoid/cyclonedds.xml",
      "destination": "etc/zj_humanoid/cyclonedds.xml",
      "mode": "0644",
      "conffile": true
    },
    {
      "source": "common/deploy_common.py",
      "destination": "usr/lib/navi-pico-common-dep/deploy_common.py",
      "mode": "0755"
    },
    {
      "source": "common/configs/targets.json",
      "destination": "usr/lib/navi-pico-common-dep/configs/targets.json",
      "mode": "0644"
    },
    {
      "source": "common/configs/robot-types.json",
      "destination": "usr/lib/navi-pico-common-dep/configs/robot-types.json",
      "mode": "0644"
    },
    {
      "source": "COMMON_DEB_USAGE.md",
      "destination": "usr/share/doc/navi-pico-common-dep/USAGE.md",
      "mode": "0644"
    }
  ]
}
