# Shared Middleware environment for all Pico modules.
# Always start from a clean ROS 2 shell.  Pico images may inherit ROS 1
# variables from vendor login scripts; leaving them set makes the Humble
# setup script reject the environment or resolve the wrong Python interfaces.
unset ROS_DISTRO ROS_VERSION ROS_PYTHON_VERSION ROS_PACKAGE_PATH ROS_ETC_DIR ROS_ROOT ROS_MASTER_URI ROS_IP ROS_HOSTNAME
_middleware_strip_path_entries() {
    local _name="$1" _old _entry _new="" _ifs
    _old="${!_name-}"; _ifs="$IFS"; IFS=:
    for _entry in $_old; do
        case "$_entry" in
            *\/opt\/ros\/noetic*|*\/opt\/ros\/foxy*) continue ;;
        esac
        [ -n "$_entry" ] || continue
        [ -n "$_new" ] && _new="$_new:"
        _new="$_new$_entry"
    done
    IFS="$_ifs"; export "$_name=$_new"
}
for _middleware_path_var in PATH LD_LIBRARY_PATH PYTHONPATH PKG_CONFIG_PATH CMAKE_PREFIX_PATH AMENT_PREFIX_PATH COLCON_PREFIX_PATH; do
    _middleware_strip_path_entries "$_middleware_path_var"
done
unset _middleware_path_var

# This carrier-installed file exists before any module postinst script runs.
# ROS setup scripts read optional variables directly, so temporarily disable
# nounset when this file is sourced by a strict shell (``set -u``).
_middleware_restore_nounset=0
case "$-" in
    *u*) _middleware_restore_nounset=1; set +u ;;
esac

if [ -r /etc/profile.d/zj_humanoid.sh ]; then
    _middleware_env_only_previous="${ZJ_PROFILE_ENV_ONLY-__MIDDLEWARE_UNSET__}"
    export ZJ_PROFILE_ENV_ONLY=1
    if ! . /etc/profile.d/zj_humanoid.sh; then
        echo "Middleware environment: device profile is not configured." >&2
    fi
    if [ "${_middleware_env_only_previous}" = "__MIDDLEWARE_UNSET__" ]; then
        unset ZJ_PROFILE_ENV_ONLY
    else
        export ZJ_PROFILE_ENV_ONLY="${_middleware_env_only_previous}"
    fi
    unset _middleware_env_only_previous
fi

_middleware_os_version=""
if [ -r /etc/os-release ]; then
    . /etc/os-release
    _middleware_os_version="${VERSION_ID:-}"
fi
case "${_middleware_os_version}" in
    20.04) export MIDDLEWARE_ROS_DISTRO="humble" ;;
    24.04) export MIDDLEWARE_ROS_DISTRO="jazzy" ;;
    *) export MIDDLEWARE_ROS_DISTRO="" ;;
esac
if [ -r "/opt/ros/${MIDDLEWARE_ROS_DISTRO}/setup.bash" ]; then
    . "/opt/ros/${MIDDLEWARE_ROS_DISTRO}/setup.bash"
fi
# Load the vendor workspace as well, so interactive shells resolve the same
# upperlimb packages and service interfaces as the supervised processes.
if [ -r /opt/zj_humanoid/setup.bash ]; then
    . /opt/zj_humanoid/setup.bash
fi
unset _middleware_os_version

export MIDDLEWARE_ENV_VERSION="1"
export MIDDLEWARE_PLATFORM="PICO"
export MIDDLEWARE_ENV_FILE="/etc/nav01/Middleware.env"
export MIDDLEWARE_CONFIG_DIR="/etc/nav01"
# Pico uses one fixed ROS 2 transport configuration.  Set these after the
# optional profile so a stale interactive-shell setting cannot diverge from
# the supervised lower-limb service.
export ROS_DOMAIN_ID=72
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export ROS_LOCALHOST_ONLY=0
export CYCLONEDDS_URI=file:///etc/zj_humanoid/cyclonedds.xml
# Vendor robot/hand runtime libraries used by robot and dexhand nodes.
export LD_LIBRARY_PATH="/opt/zj_humanoid/lib/rtipc_runtime:/opt/zj_humanoid/lib/logging:/opt/zj_humanoid/lib/uplimb_runtime:${LD_LIBRARY_PATH:-}"
# The ROS 2 daemon is a separate process and cannot be reconfigured by
# sourcing this file.  Query Pico's graph directly so an old daemon never
# hides topics from an interactive terminal.
export ROS2CLI_DISABLE_DAEMON=1

if [ "${_middleware_restore_nounset}" -eq 1 ]; then
    set -u
fi
unset _middleware_restore_nounset
