# Shared Middleware environment for all Orin modules.
# This carrier-installed file exists before any module postinst script runs.
# Middleware.env is sourced from Bash.  Load the validated device identity and
# DDS settings so every module sees the same ROBOT_TYPE configuration.
# ROS setup scripts read optional variables directly, so temporarily disable
# nounset when this file is sourced by a strict shell (``set -u``).
_middleware_restore_nounset=0
case "$-" in
    *u*) _middleware_restore_nounset=1; set +u ;;
esac

if [ -r /etc/profile.d/zj_humanoid.sh ]; then
    _middleware_env_only_previous="${ZJ_PROFILE_ENV_ONLY-__MIDDLEWARE_UNSET__}"
    export ZJ_PROFILE_ENV_ONLY=1
    if ! . /etc/profile.d/zj_humanoid.sh; then
        echo "Middleware environment: device profile is not configured." >&2
    fi
    if [ "${_middleware_env_only_previous}" = "__MIDDLEWARE_UNSET__" ]; then
        unset ZJ_PROFILE_ENV_ONLY
    else
        export ZJ_PROFILE_ENV_ONLY="${_middleware_env_only_previous}"
    fi
    unset _middleware_env_only_previous
fi

# Older device profiles may not export DDS settings in environment-only mode.
# Recover the validated transport defaults without sourcing device.env as shell code.
_middleware_device_env=/etc/zj_humanoid/device.env
_middleware_device_domain=''
_middleware_device_uri=''
if [ -r "${_middleware_device_env}" ]; then
    _middleware_device_domain=$(sed -n 's/^[[:space:]]*ROS_DOMAIN_ID[[:space:]]*=[[:space:]]*\([0-9][0-9]*\)[[:space:]]*$/\1/p' "${_middleware_device_env}" | tail -n 1)
    _middleware_device_uri=$(sed -n 's|^[[:space:]]*CYCLONEDDS_URI[[:space:]]*=[[:space:]]*\(file:///[^[:space:]]*\)[[:space:]]*$|\1|p' "${_middleware_device_env}" | tail -n 1)
fi
if ! [[ "${ROS_DOMAIN_ID:-}" =~ ^[0-9]+$ ]] || [ "${ROS_DOMAIN_ID}" -gt 232 ]; then
    if [[ "${_middleware_device_domain}" =~ ^[0-9]+$ ]] && [ "${_middleware_device_domain}" -le 232 ]; then export ROS_DOMAIN_ID="${_middleware_device_domain}"; else export ROS_DOMAIN_ID=72; fi
fi
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}"
if [ -z "${CYCLONEDDS_URI:-}" ]; then
    if [ -n "${_middleware_device_uri}" ] && [ -r "${_middleware_device_uri#file://}" ]; then export CYCLONEDDS_URI="${_middleware_device_uri}";
    elif [ -r /etc/zj_humanoid/cyclonedds.xml ]; then export CYCLONEDDS_URI=file:///etc/zj_humanoid/cyclonedds.xml; fi
fi
export ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}"
unset _middleware_device_env _middleware_device_domain _middleware_device_uri

# Load the target ROS runtime after the shared device configuration.
_middleware_os_version=""
if [ -r /etc/os-release ]; then
    . /etc/os-release
    _middleware_os_version="${VERSION_ID:-}"
fi
case "${_middleware_os_version}" in
    22.04) export MIDDLEWARE_ROS_DISTRO="humble" ;;
    24.04) export MIDDLEWARE_ROS_DISTRO="jazzy" ;;
    *) export MIDDLEWARE_ROS_DISTRO="" ;;
esac
if [ -n "${MIDDLEWARE_ROS_DISTRO}" ] && [ -r "/opt/ros/${MIDDLEWARE_ROS_DISTRO}/setup.bash" ]; then
    . "/opt/ros/${MIDDLEWARE_ROS_DISTRO}/setup.bash"
fi
unset _middleware_os_version

export MIDDLEWARE_ENV_VERSION="1"
export MIDDLEWARE_PLATFORM="ORIN"
export MIDDLEWARE_ENV_FILE="/etc/naviai/Middleware.env"
export MIDDLEWARE_CONFIG_DIR="/etc/naviai"

if [ "${_middleware_restore_nounset}" -eq 1 ]; then
    set -u
fi
unset _middleware_restore_nounset
