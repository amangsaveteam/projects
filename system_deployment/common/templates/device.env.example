# Copy to /etc/zj_humanoid/device.env and set values for this physical robot.
# Only KEY=VALUE lines are accepted; shell expressions are intentionally ignored.
# ZJ_DEVICE=ORIN
# ZJ_DEVICE=RDK
# ROBOT_TYPE=I3-S
# ROBOT_NAME=robot-001
# ZJ_VERSION=2.0.0
ROS_DOMAIN_ID=72
# Optional override. The package default is file:///etc/zj_humanoid/cyclonedds.xml.
# CYCLONEDDS_URI=file:///etc/zj_humanoid/cyclonedds.xml
# COMPOSE_PROFILES=i3
