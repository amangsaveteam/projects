{
  "schema_version": 1,
  "name": "Navi Pico Humble supervised modules",
  "output_name": "navi_pico_lowerlimb_installer-2.0.1-release-humble-amd64",
  "target": {
    "platform": "PICO",
    "os_version": "20.04",
    "architecture": "amd64",
    "internal_ip": "192.168.217.66",
    "middleware_env": "/etc/nav01/Middleware.env",
    "agent_service": "navi-pico-supervisor-agent",
    "agent_port": 9080,
    "module_root": "/etc/nav01/supervised-stack",
    "runtime_root": "/run/naviai",
    "log_root": "/var/log/naviai",
    "agent_modules_directory": "/etc/nav01/supervisor-agent/modules.d",
    "agent_password_file": "/etc/nav01/supervisor-agent/supervisor-rpc.password",
    "environment_files": {
      "middleware_env": "common/templates/Middleware.pico.env",
      "profile": "common/files/etc/profile.d/zj_humanoid.sh",
      "cyclonedds": "common/files/etc/zj_humanoid/cyclonedds.xml",
      "device_env": "supervised_stack/templates/pico-device.env"
    }
  },
  "modules": [
    {
      "id": "agent",
      "description": "Navi Pico Supervisor Agent",
      "artifact": {
        "type": "run",
        "url": "local://output/navi_pico_supervisor_agent-1.0.0-amd64.run",
        "delivery": "embed"
      },
      "install": {
        "arguments": ["install", "--device", "PICO", "--robot-type", "{robot_type}"]
      },
      "supervisor": {"mode": "external", "port": 9080, "register": false}
    },
    {
      "id": "legged",
      "description": "Navi Pico I2 legged base and joystick stack",
      "robot_types": ["I2"],
      "artifact": {
        "type": "bundle",
        "url": "local://../dist/I2_humble_2.0.1_amd64",
        "delivery": "embed"
      },
      "install": {
        "install_directory": "/opt/naviai/legged-i2"
      },
      "hooks": {
        "pre_install": ["rm -f /etc/nav01/supervisor-agent/modules.d/upperlimb.json"]
      },
      "supervisor": {
        "mode": "managed",
        "port": 19004,
        "working_directory": "/opt/naviai/legged-i2",
        "source_files": ["/etc/nav01/Middleware.env"],
        "environment": {
          "ROS_DOMAIN_ID": "72",
          "ROS_LOCALHOST_ONLY": "0",
          "ROS_LOG_DIR": "/var/log/naviai/legged/ros",
          "JOY_DEV": "/dev/input/js0",
          "IDDP_ALG_CPU": "8"
        },
        "prelude": [
          "install -d -m 0755 \"$ROS_LOG_DIR\""
        ],
        "command": "/opt/naviai/legged-i2/start_i2.sh \"${JOY_DEV:-/dev/input/js0}\"",
        "autorestart": "true",
        "startsecs": 3,
        "startretries": 10,
        "timeout_stop_seconds": 30
      }
    },
    {
      "id": "upperlimb",
      "description": "Navi Pico I2 upper-limb interface",
      "robot_types": ["I2"],
      "artifact": {
        "type": "bundle",
        "url": "local://supervised_stack/bundles/pico-upperlimb-i2",
        "delivery": "embed"
      },
      "install": {
        "install_directory": "/opt/naviai/upperlimb-i2"
      },
      "supervisor": {
        "mode": "managed",
        "service_name": "navi-pico-upperlimb",
        "port": 19003,
        "working_directory": "/opt/naviai/upperlimb-i2",
        "source_files": ["/etc/nav01/Middleware.env"],
        "environment": {
          "ROS_DOMAIN_ID": "72",
          "ROS_LOCALHOST_ONLY": "0",
          "ROS_LOG_DIR": "/var/log/naviai/upperlimb/ros",
          "IDDP_ALG_CPU": "9"
        },
        "prelude": [
          "install -d -m 0755 \"$ROS_LOG_DIR\""
        ],
        "command": "/opt/naviai/upperlimb-i2/start_i2_upperlimb.sh /opt/naviai/upperlimb-i2/hardware_body.yaml",
        "after_services": ["navi-pico-legged-supervisor"],
        "part_of_services": ["navi-pico-legged-supervisor"],
        "autorestart": "true",
        "startsecs": 3,
        "startretries": 10,
        "timeout_stop_seconds": 30
      }
    }
  ]
}
