[Unit]
Description=Jetson Orin Audio ROS 2 stack (Supervisor)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/navi-audio /var/log/naviai

[Service]
Type=simple
ExecStart=/bin/bash /etc/naviai/audio/supervisor-entrypoint.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
