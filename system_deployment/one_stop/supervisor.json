{
  "schema_version": 1,
  "targets": {
    "orin-humble": {
      "supervisor": {
        "internal_ip": "192.168.217.100",
        "agent_service": "zj-humanoid-orin-supervisor-agent.service",
        "agent_modules_directory": "/etc/naviai/supervisor-agent/modules.d",
        "agent_password_file": "/etc/naviai/supervisor-agent/supervisor-rpc.password",
        "module_root": "/etc/naviai/supervised-stack",
        "runtime_root": "/run/naviai",
        "log_root": "/var/log/naviai"
      },
      "supervisor_modules": [
        {
          "id": "manip-segmentation",
          "package": "manip",
          "description": "Manip segmentation",
          "mode": "managed",
          "port": 19013,
          "working_directory": "/opt/naviai/manip/functions/bin",
          "source_files": ["/etc/naviai/Middleware.env"],
          "command": "/bin/bash /opt/naviai/manip/functions/bin/start-segmentation.sh",
          "autorestart": "unexpected",
          "startsecs": 5
        },
        {
          "id": "manip-sam6d",
          "package": "manip",
          "description": "Manip sam6d",
          "mode": "managed",
          "port": 19014,
          "working_directory": "/opt/naviai/manip/functions/bin",
          "source_files": ["/etc/naviai/Middleware.env"],
          "command": "/bin/bash /opt/naviai/manip/functions/bin/start-sam6d.sh",
          "autorestart": "unexpected",
          "startsecs": 5
        },
        {
          "id": "manip-lingbot",
          "package": "manip",
          "description": "Manip lingbot",
          "mode": "managed",
          "port": 19015,
          "working_directory": "/opt/naviai/manip/functions/bin",
          "source_files": ["/etc/naviai/Middleware.env"],
          "command": "/bin/bash /opt/naviai/manip/functions/bin/start-lingbot.sh",
          "after_services": ["navi-sensor-host.service"],
          "startup_priority": 110,
          "autorestart": "true",
          "startsecs": 5
        },
        {
          "id": "manip-hand-detect",
          "package": "manip",
          "description": "Manip hand-detect",
          "mode": "managed",
          "port": 19016,
          "working_directory": "/opt/naviai/manip/functions/bin",
          "source_files": ["/etc/naviai/Middleware.env"],
          "command": "/bin/bash /opt/naviai/manip/functions/bin/start-hand-detect.sh",
          "autorestart": "unexpected",
          "startsecs": 5
        },
        {
          "id": "chassis",
          "package": "chassis",
          "description": "底盘 ROS 2 节点",
          "mode": "managed",
          "port": 19004,
          "working_directory": "/home/naviai",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": ["install -d -o naviai -g naviai -m 0755 /var/log/naviai/chassis /var/log/naviai/chassis/ros"],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; source /etc/naviai/Middleware.env; export HOME=/home/naviai ROS_LOG_DIR=/var/log/naviai/chassis/ros; exec ros2 launch chassis chassis.launch.py'",
          "disable_services": ["zj-humanoid-chassis.service"],
          "startup_priority": 10
        },
        {
          "id": "vanjee-lidar",
          "package": "vanjee-lidar",
          "description": "万集 716 mini 雷达",
          "mode": "managed",
          "port": 19006,
          "working_directory": "/home/naviai",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": ["install -d -o naviai -g naviai -m 0755 /var/log/naviai/vanjee-lidar /var/log/naviai/vanjee-lidar/ros"],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; source /etc/naviai/Middleware.env; export HOME=/home/naviai AMENT_PREFIX_PATH=/opt/zj_humanoid:${AMENT_PREFIX_PATH:-} ROS_LOG_DIR=/var/log/naviai/vanjee-lidar/ros; exec ros2 launch vanjee_716mini_lidar vanjee_716mini_lidar_01.launch.py'",
          "disable_services": ["zj-humanoid-vanjee-lidar.service"],
          "startup_priority": 10
        },
        {
          "id": "livox-lidar",
          "package": "livox-lidar",
          "description": "Livox 雷达",
          "mode": "managed",
          "port": 19007,
          "working_directory": "/home/naviai",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": [
            "install -d -o naviai -g naviai -m 0755 /var/log/naviai/livox-lidar /var/log/naviai/livox-lidar/ros",
            "if ! /usr/bin/python3 /usr/lib/naviai/detect_livox_model.py --lidar-ip \"${LIVOX_LIDAR_IP:-192.168.217.17}\" --timeout 4; then echo 'Livox model discovery unavailable; using manual or cached LIDAR_3D_TYPE if present' >&2; fi"
          ],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; source /etc/naviai/Middleware.env; export HOME=/home/naviai AMENT_PREFIX_PATH=/opt/zj_humanoid:${AMENT_PREFIX_PATH:-} ROS_LOG_DIR=/var/log/naviai/livox-lidar/ros; exec ros2 launch livox_lidar msg_lidar_launch.py'",
          "disable_services": ["zj-humanoid-livox-lidar.service"],
          "startup_priority": 10
        },
        {
          "id": "naviai-nav2",
          "package": "naviai-nav2",
          "description": "Nav2 bringup",
          "mode": "managed",
          "port": 19008,
          "working_directory": "/home/naviai",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": ["install -d -o naviai -g naviai -m 0755 /var/log/naviai/naviai-nav2 /var/log/naviai/naviai-nav2/ros"],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; source /etc/naviai/Middleware.env; export HOME=/home/naviai ROS_LOG_DIR=/var/log/naviai/naviai-nav2/ros; for attempt in $(seq 1 120); do if ros2 pkg prefix naviai_nav2_bringup >/dev/null 2>&1; then exec ros2 launch naviai_nav2_bringup nav2_stack.launch.py; fi; sleep 1; done; echo naviai_nav2_bringup-not-installed >&2; exit 1'",
          "disable_services": ["zj-humanoid-naviai-nav2.service"],
          "startup_priority": 30,
          "startsecs": 5
        },
        {
          "id": "navigation",
          "package": "navigation",
          "description": "统一导航核心",
          "mode": "managed",
          "port": 19009,
          "working_directory": "/home/naviai",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": ["install -d -o naviai -g naviai -m 0755 /var/log/naviai/navigation /var/log/naviai/navigation/ros"],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; source /etc/naviai/Middleware.env; export HOME=/home/naviai ROS_LOG_DIR=/var/log/naviai/navigation/ros NAVIGATION_ROBOT_MODEL=${NAVIGATION_ROBOT_MODEL:-${COMPOSE_PROFILES:-wa2}} ROBOT_NAME=${ROBOT_NAME:-zj_humanoid} NAVIGATION_CONFIG_PATH=${NAVIGATION_CONFIG_PATH:-/home/naviai/navi_project/config/navigation}; exec /opt/ros/humble/share/navigation/scripts/launch.sh'",
          "disable_services": ["zj-humanoid-navigation.service"],
          "startup_priority": 20
        },
        {
          "id": "naviai-nav2-rawdata",
          "package": "naviai-nav2-rawdata",
          "description": "导航原始数据记录",
          "mode": "managed",
          "port": 19010,
          "working_directory": "/home/naviai",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": ["install -d -o naviai -g naviai -m 0755 /var/log/naviai/naviai-nav2-rawdata /var/log/naviai/naviai-nav2-rawdata/ros /var/log/zj_humanoid /var/log/zj_humanoid/l2_raw_log/data"],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; source /etc/naviai/Middleware.env; export HOME=/home/naviai AMENT_PREFIX_PATH=/opt/zj_humanoid:${AMENT_PREFIX_PATH:-} ROS_LOG_DIR=/var/log/naviai/naviai-nav2-rawdata/ros; exec ros2 launch naviai_nav2_rawdata recorder.launch.py'",
          "disable_services": ["zj-humanoid-naviai-nav2-rawdata.service"],
          "startup_priority": 40
        },
        {
          "id": "diagnosis-system",
          "package": "diagnosis-system",
          "description": "诊断系统",
          "mode": "managed",
          "port": 19011,
          "working_directory": "/home/naviai",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": ["install -d -o naviai -g naviai -m 0755 /var/log/naviai/diagnosis-system /var/log/naviai/diagnosis-system/ros"],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; source /etc/naviai/Middleware.env; export HOME=/home/naviai ROS_LOG_DIR=/var/log/naviai/diagnosis-system/ros; exec ros2 launch diagnosis_system diagnosis.launch.py'",
          "disable_services": ["zj-humanoid-diagnosis-system.service"],
          "startup_priority": 50
        },
        {
          "id": "web-rviz",
          "package": "web-rviz",
          "description": "Web RViz 页面服务",
          "mode": "managed",
          "port": 19012,
          "working_directory": "/opt/zj_humanoid/lib/web_rviz_ros2",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": [
            "export ROS_LOG_DIR=/var/log/naviai/web-rviz/ros",
            "install -d -m 0755 /var/log/naviai/web-rviz/ros /var/log/zj_humanoid/web_rviz_ros2"
          ],
          "command": "/opt/zj_humanoid/lib/web_rviz_ros2/start_web_navigation.sh",
          "disable_services": ["zj-humanoid-web-rviz-ros2.service"],
          "startup_priority": 60
        },
        {
          "id": "sensor",
          "description": "Navi Orin Sensor stack",
          "mode": "external",
          "port": 19001,
          "restart_service": "navi-sensor-host.service",
          "native_rpc_config": "/etc/naviai/navi-sensor-host-supervisor.conf"
        },
        {
          "id": "robot",
          "description": "Jetson Orin robot-state ROS 2 stack (Supervisor)",
          "mode": "managed",
          "port": 19002,
          "working_directory": "/var/lib/navi",
          "source_files": [
            "/etc/naviai/Middleware.env",
            "/etc/naviai/robot/robot_env.sh"
          ],
          "environment": {
            "HOME": "/var/lib/navi",
            "ROS_HOME": "/var/lib/navi/ros",
            "ROS_LOG_DIR": "/var/log/navi/ros",
            "NAVI_ORIN_ROBOT_LOG_DIR": "/var/log/navi/robot",
            "NAVI_ORIN_ROBOT_LOG_LEVEL": "INFO",
            "RCUTILS_COLORIZED_OUTPUT": "0",
            "RCUTILS_LOGGING_USE_STDOUT": "1",
            "RCUTILS_LOGGING_BUFFERED_STREAM": "1"
          },
          "command": "ros2 launch orin_robot orin_robot.launch.py",
          "autorestart": "unexpected",
          "startsecs": 3,
          "timeout_stop_seconds": 20,
          "remove_packages": [
            "navi-robot-state"
          ]
        },
        {
          "id": "audio",
          "description": "Jetson Orin Audio ROS 2 stack (Supervisor)",
          "mode": "managed",
          "port": 19003,
          "working_directory": "/var/lib/navi-audio",
          "unset_environment": [
            "AMENT_PREFIX_PATH",
            "COLCON_PREFIX_PATH",
            "CMAKE_PREFIX_PATH",
            "PYTHONPATH"
          ],
          "source_files": [
            "/etc/naviai/Middleware.env",
            "/opt/ros/humble/setup.bash",
            "/opt/naviai/venvs/audio/bin/activate"
          ],
          "prelude": [
            "set -a",
            "source /etc/navi-audio/audio.env",
            "set +a",
            "export HOME=/var/lib/navi-audio",
            "export ROS_HOME=/var/lib/navi-audio/ros",
            "export ROS_LOG_DIR=/var/log/naviai/audio/ros",
            "install -d -m 0755 \"$HOME\" \"$ROS_HOME\" \"$ROS_LOG_DIR\""
          ],
          "command": "ros2 launch navi_audio_pkg audio_bringup.launch.py intent_router_mode:=bt enable_face_bridge:=true voiceprint_adapter_mode:=real gesture_backend:=pico pico_gateway_url:=ws://192.168.217.66:8765 enable_background_task_test:=true",
          "autorestart": "unexpected",
          "startsecs": 5,
          "start_policy": "supervisor"
        },
        {
          "id": "vision",
          "description": "Navi Vision Humble",
          "mode": "managed",
          "port": 19005,
          "working_directory": "/var/lib/navi-vision/supervised",
          "prelude": [
            "install -d -o naviai -g naviai -m 0750 /var/log/naviai/vision",
            "install -d -o naviai -g naviai -m 0755 /var/lib/navi-vision/supervised /var/lib/navi-vision/supervised/ros /var/lib/navi-vision/supervised/ultralytics /var/log/naviai/vision/ros"
          ],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; export HOME=/home/naviai; source /etc/naviai/Middleware.env; source /usr/lib/orin-vision-common-deb/vision_environment.sh; set +u; export ROS_HOME=/var/lib/navi-vision/supervised/ros ROS_LOG_DIR=/var/log/naviai/vision/ros YOLO_CONFIG_DIR=/var/lib/navi-vision/supervised/ultralytics; exec ros2 launch navi_vision_pkg face_detection_node.launch.py selected_camera:=auto camera_auto_timeout_sec:=8.0'",
          "startsecs": 20,
          "after_services": [
            "navi-sensor-host.service"
          ],
          "disable_services": [
            "navi-vision.service",
            "navi-vision-supervisor.service"
          ],
          "start_policy": "vision-preserve-shared"
        }
      ]
    },
    "orin-jazzy": {
      "supervisor": {
        "internal_ip": "192.168.217.100",
        "agent_service": "zj-humanoid-orin-supervisor-agent.service",
        "agent_modules_directory": "/etc/naviai/supervisor-agent/modules.d",
        "agent_password_file": "/etc/naviai/supervisor-agent/supervisor-rpc.password",
        "module_root": "/etc/naviai/supervised-stack",
        "runtime_root": "/run/naviai",
        "log_root": "/var/log/naviai"
      },
      "supervisor_modules": [
        {
          "id": "vision",
          "description": "Navi Vision Jazzy",
          "mode": "managed",
          "service_name": "zj-humanoid-orin-vision-supervisor",
          "port": 19005,
          "working_directory": "/var/lib/navi-vision/supervised",
          "prelude": [
            "install -d -o naviai -g naviai -m 0750 /var/log/naviai/vision",
            "install -d -o naviai -g naviai -m 0755 /var/lib/navi-vision/supervised /var/lib/navi-vision/supervised/ros /var/lib/navi-vision/supervised/ultralytics /var/log/naviai/vision/ros"
          ],
          "command": "runuser -u naviai -- /bin/bash -c 'set -e; unset AMENT_PREFIX_PATH COLCON_PREFIX_PATH CMAKE_PREFIX_PATH PYTHONPATH; source /etc/naviai/Middleware.env; unset AMENT_PREFIX_PATH COLCON_PREFIX_PATH CMAKE_PREFIX_PATH PYTHONPATH; source /opt/ros/jazzy/setup.bash; source /opt/naviai/venvs/vision/bin/activate; export HOME=/home/naviai ROS_HOME=/var/lib/navi-vision/supervised/ros ROS_LOG_DIR=/var/log/naviai/vision/ros YOLO_CONFIG_DIR=/var/lib/navi-vision/supervised/ultralytics ROS_DOMAIN_ID=72 ROS_LOCALHOST_ONLY=0 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp; unset CYCLONEDDS_URI; exec ros2 launch navi_vision_pkg face_detection_node.launch.py selected_camera:=auto camera_auto_timeout_sec:=8.0'",
          "startsecs": 20,
          "after_services": [
            "navi-sensor-host.service"
          ]
        }
      ]
    },
    "pico-humble": {
      "supervisor": {
        "internal_ip": "192.168.217.66",
        "agent_service": "zj-humanoid-pico-supervisor-agent.service",
        "agent_modules_directory": "/etc/nav01/supervisor-agent/modules.d",
        "agent_password_file": "/etc/nav01/supervisor-agent/supervisor-rpc.password",
        "module_root": "/etc/nav01/supervised-stack",
        "runtime_root": "/run/naviai",
        "log_root": "/var/log/naviai"
      },
      "supervisor_modules": [
        {
          "id": "robot",
          "description": "Navi PICO robot hardware stack",
          "mode": "external",
          "port": 19002,
          "startup_priority": 10,
          "restart_service": "zj-humanoid-pico-robot-supervisor.service",
          "disable_services": [
            "navi-pico-robot-supervisor.service",
            "navi-pico-legged-supervisor.service",
            "zj_humanoid.service"
          ]
        },
        {
          "id": "upperlimb",
          "description": "Navi PICO upperlimb stack",
          "mode": "managed",
          "port": 19003,
          "startup_priority": 20,
          "working_directory": "/etc/nav01/upperlimb",
          "source_files": [
            "/etc/nav01/Middleware.env"
          ],
          "prelude": [
            "export HOME=/home/nav01 ROS_HOME=/home/nav01/.ros ROS_LOG_DIR=/var/log/naviai/upperlimb/ros",
            "install -d -o nav01 -g nav01 -m 0755 /home/nav01/.ros /var/log/naviai/upperlimb/ros"
          ],
          "readiness_command": "state=\"$(timeout 5 ros2 topic echo --once /zj_humanoid/robot/robot_state 2>/dev/null || true)\"; grep -q '^state: 5$' <<< \"$state\" && grep -q '^state_info: STATE_ROBOT_RUN$' <<< \"$state\"",
          "command": "/bin/bash /etc/nav01/upperlimb/navi-pico-upperlimb-start.sh",
          "local_log_file": "/var/log/naviai/upperlimb/upperlimb.log",
          "autorestart": "unexpected",
          "startsecs": 0,
          "disable_services": [
            "navi-pico-upperlimb.service"
          ]
        },
        {
          "id": "display",
          "description": "Navi PICO display media player",
          "mode": "managed",
          "port": 19004,
          "startup_priority": 1,
          "working_directory": "/opt/navi_display",
          "source_files": [
            "/etc/nav01/Middleware.env",
            "/opt/ros/humble/setup.bash",
            "/opt/navi_display/ros/setup.bash"
          ],
          "prelude": [
            "export HOME=/var/lib/navi-display ROS_HOME=/var/lib/navi-display/ros ROS_LOG_DIR=/var/log/naviai/display/ros",
            "install -d -m 0755 /var/lib/navi-display /var/lib/navi-display/ros /var/log/naviai/display/ros"
          ],
          "command": "ros2 launch media_play media_play.launch.py",
          "autorestart": "true",
          "startsecs": 0
        }
      ],
      "managed_services": [
        "zj-humanoid-pico-robot-supervisor.service"
      ]
    }
  }
}
