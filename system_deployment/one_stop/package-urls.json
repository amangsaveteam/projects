{
  // 唯一的交付配置文件：在这里维护所有目标和模块 URL。
  // A target is included automatically when it defines system_config or common.url.
  // All Common DEBs are built and published by their target-specific build
  // machines. This installer downloads them from the artifact server.
  // extra_debs and runs are installed in their listed order.
  "schema_version": 1,
  "targets": {
    "orin-humble": {
      "device": "ORIN",
      "os_id": "ubuntu",
      "os_version": "22.04",
      "architecture": "arm64",
      "system_config": { "configure_target": "orin-humble", "base_image_contract": "orin-humble" },
      "sensor_parent_compatibility": true,
      "supervisor": {
        "internal_ip": "192.168.217.100",
        "agent_service": "navi-orin-supervisor-agent.service",
        "agent_modules_directory": "/etc/naviai/supervisor-agent/modules.d",
        "agent_password_file": "/etc/naviai/supervisor-agent/supervisor-rpc.password",
        "module_root": "/etc/naviai/supervised-stack",
        "runtime_root": "/run/naviai",
        "log_root": "/var/log/naviai"
      },
      "supervisor_modules": [
        {
          "id": "chassis",
          "description": "Navi Orin ROS 2 chassis node",
          "mode": "managed",
          "service_name": "navi-orin-chassis",
          "port": 19004,
          "working_directory": "/var/lib/naviai/navi-orin-chassis",
          "source_files": ["/etc/naviai/Middleware.env"],
          "prelude": [
            "export HOME=/root",
            "export ROS_HOME=/var/lib/naviai/navi-orin-chassis",
            "export ROS_LOG_DIR=/var/log/naviai/navi-orin-chassis",
            "install -d -m 0755 \"$ROS_HOME\" \"$ROS_LOG_DIR\""
          ],
          "command": "ros2 launch chassis chassis.launch.py",
          "autorestart": "true",
          "startsecs": 3
        },
        {
          "id": "sensor",
          "description": "Navi Orin Sensor stack",
          "mode": "external",
          "port": 19001,
          "restart_service": "navi-sensor-host.service"
        },
        {
          "id": "robot",
          "description": "Jetson Orin robot-state ROS 2 stack (Supervisor)",
          "mode": "managed",
          "port": 19002,
          "working_directory": "/var/lib/navi",
          "source_files": ["/etc/naviai/Middleware.env", "/etc/naviai/robot/robot_env.sh"],
          "environment": {
            "HOME": "/var/lib/navi",
            "ROS_HOME": "/var/lib/navi/ros",
            "ROS_LOG_DIR": "/var/log/navi/ros",
            "NAVI_ORIN_ROBOT_LOG_DIR": "/var/log/navi/robot",
            "NAVI_ORIN_ROBOT_LOG_LEVEL": "INFO",
            "RCUTILS_COLORIZED_OUTPUT": "0",
            "RCUTILS_LOGGING_USE_STDOUT": "1",
            "RCUTILS_LOGGING_BUFFERED_STREAM": "1"
          },
          "command": "ros2 launch orin_robot orin_robot.launch.py",
          "autorestart": "unexpected",
          "startsecs": 3,
          "timeout_stop_seconds": 20
        },
        {
          "id": "audio",
          "description": "Jetson Orin Audio ROS 2 stack (Supervisor)",
          "mode": "managed",
          "port": 19003,
          "working_directory": "/var/lib/navi-audio",
          "unset_environment": ["AMENT_PREFIX_PATH", "COLCON_PREFIX_PATH", "CMAKE_PREFIX_PATH", "PYTHONPATH"],
          "source_files": [
            "/etc/naviai/Middleware.env",
            "/opt/ros/humble/setup.bash",
            "/opt/naviai/venvs/audio/bin/activate"
          ],
          "prelude": [
            "set -a",
            "source /etc/navi-audio/audio.env",
            "set +a",
            "export HOME=/var/lib/navi-audio",
            "export ROS_HOME=/var/lib/navi-audio/ros",
            "export ROS_LOG_DIR=/var/log/naviai/audio/ros",
            "install -d -m 0755 \"$HOME\" \"$ROS_HOME\" \"$ROS_LOG_DIR\""
          ],
          "command": "ros2 launch navi_audio_pkg audio_bringup.launch.py intent_router_mode:=bt enable_face_bridge:=true voiceprint_adapter_mode:=real gesture_backend:=pico pico_gateway_url:=ws://192.168.217.66:8765 enable_background_task_test:=true",
          "autorestart": "unexpected",
          "startsecs": 5
        },
        {
          "id": "vision",
          "description": "Navi Vision ROS 2 stack (Supervisor)",
          "mode": "managed",
          "service_name": "navi-vision-supervisor",
          "port": 19005,
          "working_directory": "/var/lib/navi-vision",
          "unset_environment": ["AMENT_PREFIX_PATH", "COLCON_PREFIX_PATH", "CMAKE_PREFIX_PATH", "PYTHONPATH"],
          "source_files": [
            "/etc/naviai/Middleware.env",
            "/opt/ros/humble/setup.bash",
            "/opt/naviai/venvs/vision/bin/activate"
          ],
          "prelude": [
            "export HOME=/home/naviai",
            "export YOLO_CONFIG_DIR=/var/lib/navi-vision/ultralytics",
            "export ROS_DOMAIN_ID=72",
            "export ROS_LOCALHOST_ONLY=0",
            "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp",
            "unset CYCLONEDDS_URI",
            "install -d -m 0755 \"$YOLO_CONFIG_DIR\""
          ],
          "command": "ros2 launch navi_vision_pkg face_detection_node.launch.py selected_camera:=auto camera_auto_timeout_sec:=8.0",
          "autorestart": "unexpected",
          "startsecs": 5
        }
      ],
      "extra_debs": [
        {
          "name": "orin-common",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/common/orin/develop/navi_common_dep-2.0.0-release-humble-arm64.deb",
          "sha256": "",
          "installers": ["auto"]
        },
        {
          "name": "sensor",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/common/orin/sensor/navi_sensor_dep-2.0.0-release-humble-arm64.deb",
          "sha256": "",
          "installers": ["auto"]
        },
        {
          "name": "robot",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/orin_robot/develop/navi_robot_dep-2.0.0-release-humble-arm64.deb",
          "sha256": "",
          "installers": ["auto"],
          "environment": { "PIP_NO_BUILD_ISOLATION": "1" }
        }
      ],
      "runs": [
        { "name": "chassis", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/chassis/develop/navi_chassis_orin_installer-2.0.0-release-humble-arm64.run", "sha256": "", "arguments": ["--", "--robot-type", "{robot_type}"] },
        { "name": "sensor", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/sensor/develop/navi_sensor_installer-2.0.0-release-humble-arm64.run", "sha256": "", "arguments": ["--", "--robot-type", "{robot_type}"] },
        { "name": "robot", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/orin_robot/develop/navi_robot_installer-2.0.0-release-humble-arm64.run", "sha256": "", "arguments": [] },
        { "name": "audio", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/audio/humble/navi_audio_installer-2.0.0-release-humble-arm64.run", "sha256": "", "arguments": [], "start_policy": "supervisor" },
        { "name": "vision", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/vision/develop/navi_vision_installer-2.0.0-release-humble-arm64.run", "sha256": "", "arguments": [] }
      ]
    },
    "orin-jazzy": {
      "device": "ORIN",
      "os_id": "ubuntu",
      "os_version": "24.04",
      "architecture": "arm64",
      "system_config": { "configure_target": "orin-jazzy", "base_image_contract": "orin-jazzy" },
      "vision_supervisor": { "service": "navi-vision-supervisor.service", "ros_distro": "jazzy" },
      "extra_debs": [
        {
          "name": "sensor",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/common/orin/sensor/jazzy/navi_sensor_dep-2.0.0-release-jazzy-arm64.deb",
          "sha256": "",
          "installers": ["auto"]
        },
        {
          "name": "robot",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/orin_robot/jazzy/navi_robot_dep-2.0.0-release-jazzy-arm64.deb",
          "sha256": "",
          "installers": ["auto"],
          "environment": { "PIP_NO_BUILD_ISOLATION": "1" }
        }
      ],
      "runs": [
        { "name": "chassis", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/chassis/jazzy/navi_chassis_orin_installer-2.0.0-release-jazzy-arm64.run", "sha256": "", "arguments": ["--", "--robot-type", "{robot_type}"] },
        { "name": "sensor", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/sensor/jazzy/navi_sensor_installer-2.0.0-release-jazzy-arm64.run", "sha256": "", "arguments": ["--", "--robot-type", "{robot_type}"] },
        { "name": "robot", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/orin_robot/jazzy/navi_robot_installer-2.0.0-release-jazzy-arm64.run", "sha256": "", "arguments": [] },
        { "name": "audio", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/audio/jazzy/jenkins-audio_jazzy-54/navi_audio_installer-2.0.0-release-jazzy-arm64.run", "sha256": "", "arguments": [] },
        { "name": "vision", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/vision/jazzy/navi_vision_installer-2.0.0-release-jazzy-arm64.run", "sha256": "", "arguments": [] }
      ]
    },
    "pico-humble": {
      "device": "PICO",
      "os_id": "ubuntu",
      "os_version": "20.04",
      "architecture": "amd64",
      "system_config": { "configure_target": "pico-humble", "base_image_contract": "pico-humble" },
      "supervisor": {
        "internal_ip": "192.168.217.66",
        "agent_service": "navi-pico-supervisor-agent.service",
        "agent_modules_directory": "/etc/nav01/supervisor-agent/modules.d",
        "agent_password_file": "/etc/nav01/supervisor-agent/supervisor-rpc.password",
        "module_root": "/etc/nav01/supervised-stack",
        "runtime_root": "/run/naviai",
        "log_root": "/var/log/naviai"
      },
      "managed_services": [
        "navi-pico-robot-supervisor.service",
        "navi-pico-upperlimb.service"
      ],
      "supervisor_modules": [
        {
          "id": "robot",
          "description": "Navi PICO robot hardware stack",
          "mode": "external",
          "port": 19002,
          "restart_service": "navi-pico-robot-supervisor.service"
        },
        {
          "id": "upperlimb",
          "description": "Navi PICO upperlimb stack",
          "mode": "external",
          "port": 19003,
          "restart_service": "navi-pico-upperlimb.service"
        }
      ],
      "extra_debs": [
        {
          "name": "pico-common",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/common/pico/develop/navi_pico_common_dep-2.0.0-release-humble-amd64.deb",
          "sha256": "",
          "installers": ["auto"]
        },
        {
          "name": "upperlimb-common",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/upperlimb/develop/navi_pico_upperlimb_common_dep-2.0.0-release-humble-amd64.deb",
          "sha256": "",
          "installers": ["auto"]
        },
        {
          "name": "robot",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/robot/develop/navi_pico_robot_dep-2.0.0-release-humble-amd64.deb",
          "sha256": "",
          "installers": ["auto"]
        }
      ],
      "runs": [
        { "name": "robot", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/robot/develop/navi_pico_robot_installer-2.0.0-release-humble-amd64.run", "sha256": "" },
        { "name": "upperlimb", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/upperlimb/develop/navi_pico_upperlimb_installer-2.0.0-release-humble-amd64.run", "sha256": "" }
      ]
    },
    "pico-jazzy": {
      "device": "PICO",
      "os_id": "ubuntu",
      "os_version": "24.04",
      "architecture": "amd64",
      "system_config": { "configure_target": "pico-jazzy", "base_image_contract": "pico-jazzy" },
      "extra_debs": [],
      "runs": [
        { "name": "upperlimb", "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/upperlimb/jazzy/navi_pico_upperlimb_installer-2.0.0-release-jazzy-amd64.run", "sha256": "" }
      ]
    },
    "rdk-jazzy": {
      "device": "RDK",
      "os_id": "rdk os",
      "os_version": "V5.1.0",
      "architecture": "arm64",
      "system_config": { "configure_target": "rdk-jazzy", "base_image_contract": "rdk-jazzy" },
      "extra_debs": [
        {
          "name": "sensor",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/common/rdk/sensor/navi_rdk_sensor_dep-2.0.0-release-jazzy-arm64.deb",
          "sha256": "",
          "installers": ["auto"]
        },
        {
          "name": "realsense2-description",
          "url": "http://10.51.33.211:10000/chfs/shared/ros2_modules/sensor/rdk/ros-jazzy-realsense2-description-2.0.0-release-20260813%5B937c915a%5D-arm64.deb",
          "sha256": "",
          "installers": []
        }
      ],
