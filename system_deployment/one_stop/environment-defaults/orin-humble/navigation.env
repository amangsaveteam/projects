# Orin Humble navigation environment.
# Created only on the first one-stop installation. Later installations retain
# local edits. Set LIDAR_3D_TYPE here to override automatic discovery.
export NAVIGATION_ROBOT_MODEL="${NAVIGATION_ROBOT_MODEL:-${COMPOSE_PROFILES:-wa2}}"
export NAVIGATION_CONFIG_PATH="${NAVIGATION_CONFIG_PATH:-/home/naviai/navi_project/config/navigation}"
# Livox hardware uses a static IP. Override this value if the sensor network
# is changed; the managed Livox service then detects MID360 vs MID360S safely.
export LIVOX_LIDAR_IP="${LIVOX_LIDAR_IP:-192.168.217.17}"
# export LIDAR_3D_TYPE=MID360

# The Livox managed service creates /etc/naviai/navigation/lidar.auto.env with
# the installed SDK. Middleware.env loads that cache only when no explicit
# LIDAR_3D_TYPE is set here.
