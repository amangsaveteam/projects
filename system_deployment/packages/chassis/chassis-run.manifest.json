{
  // ORIN Ubuntu 22.04 / ROS 2 Humble chassis deployment.
  "version": "2.0.0",
  "branch_name": "external-chassis",
  "commit_id": "0jammy",
  "output_name": "navi_chassis_orin_installer-2.0.0-release-humble-arm64",
  "ORIN": {
    "sys_env_version": "ubuntu-22.04",
    // Optional endpoint overrides.  Leave commented to use the launch-file
    // defaults: chassis_type=COMPOSE_PROFILES (or wa2), host=192.168.217.1,
    // port=8849.  These are written into the sole shared Middleware.env.
    // "environment": {
    //   "CHASSIS_TYPE": "wa2",
    //   "CHASSIS_HOST": "192.168.217.1",
    //   "CHASSIS_PORT": "8849"
    // },
    "scripts": {
      // The legacy package owns liblog_agent.so, which is now supplied by
      // zj-humanoid-log-l1.  Remove it before installing the replacement;
      // --force-depends is safe for this short transaction because the next
      // module immediately restores the zj-humanoid-naviai-log virtual
      // dependency through the compatibility package below.
      "pre_install": [
        {
          "name": "replace-legacy-naviai-log",
          "cmd": "if dpkg-query -W -f='${db:Status-Status}' zj-humanoid-naviai-log 2>/dev/null | grep -qx installed; then dpkg --remove --force-depends zj-humanoid-naviai-log; fi"
        }
      ],
      "post_install": [],
      "pre_uninstall": [],
      "post_uninstall": []
    },
    "modules": [
      {
        "name": "zj-humanoid-log-l1",
        "version": "1.0.0-0jammy",
        "url": "local://input/zj-humanoid-log-l1_1.0.0-0jammy_arm64.deb",
        "image": "",
        "dst": "deb",
        "dependencies": [],
        "sha256": "73184dcaf58047fd9ffc3827fea61a3edabf9779735f8c21b1685d7f657e3116"
      },
      {
        "name": "zj-humanoid-naviai-log-compat",
        "version": "2204+latest-0jammy.compat2",
        "url": "local://input/zj-humanoid-naviai-log-compat_2204+latest-0jammy.compat2_arm64.deb",
        "image": "",
        "dst": "deb",
        "dependencies": ["zj-humanoid-log-l1"],
        "sha256": "691bc2ffd104cb1dd3a519edaca293885aa05abca62c3e0b3967121edb2830ec"
      },
      {
        "name": "zj-humanoid-ros-humble-chassis-msgs",
        "version": "2.0.0-0jammy",
        "url": "local://input/zj-humanoid-ros-humble-chassis-msgs_2.0.0-0jammy_arm64.deb",
        "image": "",
        "dst": "deb",
        "dependencies": [],
        "sha256": "4bac710b59288832f72114ab2670d0156919ff5fae3da985d7336a74a6fa3e6b"
      },
      {
        "name": "zj-humanoid-ros-humble-chassis",
        "version": "2.0.0-0jammy",
        "url": "local://input/zj-humanoid-ros-humble-chassis_2.0.0-0jammy_arm64.deb",
        "image": "",
        "dst": "deb",
        "dependencies": ["zj-humanoid-ros-humble-chassis-msgs"],
        "sha256": "3c2715610ad69cf23f1c689e7c03be4c780d2e1f6e245d2f0dd0310ee7428979"
