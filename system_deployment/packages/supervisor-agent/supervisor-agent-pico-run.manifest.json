{
  "version": "1.0.0",
  "branch_name": "supervisor-agent-pico",
  "commit_id": "local",
  "output_name": "navi_pico_supervisor_agent-1.0.0-amd64",
  "PICO": {
    "sys_env_version": "ubuntu-20.04",
    "modules": [],
    "resource": [
      {
        "local_path": "resources/navi_supervisor_agent.py",
        "device_path": "/etc/nav01/supervisor-agent/navi_supervisor_agent.py"
      },
      {
        "local_path": "resources/pico-modules.json",
        "device_path": "/etc/nav01/supervisor-agent/modules.json"
      }
    ],
    "scripts": {
      "pre_install": [
        {
          "name": "require-python3",
          "cmd": "command -v python3 >/dev/null || { echo 'ERROR: python3 is required for the Supervisor Agent' >&2; exit 1; }"
        }
      ],
      "post_install": [
        {
          "name": "initialize-agent-secrets",
          "path": "scripts/initialize_agent_secrets.py"
        }
      ],
      "pre_uninstall": [],
      "post_uninstall": []
    },
    "startup": {
      "name": "navi-pico-supervisor-agent",
      "description": "Navi Pico Supervisor Agent",
      "command": "/usr/bin/python3 /etc/nav01/supervisor-agent/navi_supervisor_agent.py --config /etc/nav01/supervisor-agent/modules.json",
      "script_directory": "/etc/nav01/supervisor-agent",
      "restart": "on-failure",
      "start_on_install": true
    }
  }
}
